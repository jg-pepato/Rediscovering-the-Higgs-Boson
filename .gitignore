# Pipeline-generated data (do not commit large, generated ROOT files)
/data/raw/
/data/skimmed/
/analysis/
/reduced_dataset/
/results/

# Keep only chained ROOT files, ignore individual skimmed files
/data/skimmed/**/*.root
!*_chained.root

# Model weight files (keep source scripts in /extra/)
/extra/*.keras
/extra/*.h5

# Preprocessing logs and caches (created by scripts)
/preprocessing/logs/
/preprocessing/__pycache__/

# Python-related
__pycache__/
*.py[cod]
*.so
*.egg-info/
*.pyc
*.pyo
*.pyd

# Virtual environments and env files
.venv/
venv/
env/
.env
.envrc

# Editor / OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
.pytest_cache/
.ipynb_checkpoints/

# macOS
.AppleDouble
.LSOverride

